<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit chat</title>
</head>
<body>
    <h3>Edit your Chat id <%=chat._id%></h3>
    <p>this chat is send from <%=chat.from%> to <%=chat.to%> .</p>
    <form method="POST" action="/chats/<%=chat._id%>?_method=PUT">
        <textarea name="message" rows="50" cols="50" ><%= chat.message && chat.message.trim() !== "" ? chat.message : "[No message]" %>
</textarea>
        <button>Edit</button>
    </form>
</body>
</html>